<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Tracks individual and bulk scheduled email sends created from Weave templates.</description>
    <enableActivities>false</enableActivities>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <label>Weave Scheduled Send</label>
    <nameField>
        <label>Send Name</label>
        <type>AutoNumber</type>
        <displayFormat>WSS-{0000}</displayFormat>
        <startingNumber>1</startingNumber>
    </nameField>
    <pluralLabel>Weave Scheduled Sends</pluralLabel>
    <sharingModel>ControlledByParent</sharingModel>
</CustomObject>
