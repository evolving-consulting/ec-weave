<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Audit log of emails sent via Weave. Records the template used, the source record, the sender, and recipient count.</description>
    <enableActivities>false</enableActivities>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <label>Weave Send Log</label>
    <nameField>
        <label>Weave Send Log Name</label>
        <type>AutoNumber</type>
        <displayFormat>WEAVE-LOG-{0000000}</displayFormat>
    </nameField>
    <pluralLabel>Weave Send Logs</pluralLabel>
    <sharingModel>Private</sharingModel>
</CustomObject>
