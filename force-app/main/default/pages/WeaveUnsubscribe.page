<apex:page controller="WeaveUnsubscribeController" showHeader="false" sidebar="false" standardStylesheets="false" docType="html-5.0">
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Unsubscribe</title>
    <style>
        body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f4f5f7; }
        .container { max-width: 480px; margin: 60px auto; background: #fff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,.1); padding: 40px 32px; text-align: center; }
        .logo { max-width: 160px; max-height: 60px; margin-bottom: 24px; }
        .brand-name { font-size: 18px; font-weight: 600; color: #333; margin-bottom: 24px; }
        h1 { font-size: 22px; color: #1a1a2e; margin: 0 0 12px; }
        p  { font-size: 15px; color: #555; margin: 0 0 24px; line-height: 1.5; }
        .btn { display: inline-block; padding: 10px 24px; border-radius: 6px; font-size: 15px; font-weight: 500; cursor: pointer; border: none; text-decoration: none; }
        .btn-primary { background: #1f5f5b; color: #fff; }
        .btn-secondary { background: #e8e8e8; color: #333; }
        .icon { font-size: 48px; margin-bottom: 16px; }
    </style>
</head>
<body>
<apex:form id="initForm">
    <apex:actionFunction name="doInit" action="{!init}" reRender="bodyPanel"/>
</apex:form>
<script>document.addEventListener('DOMContentLoaded', function() { doInit(); });</script>
<div class="container">
<apex:outputPanel id="bodyPanel">
    <apex:outputPanel rendered="{!NOT(ISBLANK(logoUrl))}">
        <img src="{!logoUrl}" alt="{!brandName}" class="logo"/>
    </apex:outputPanel>
    <apex:outputPanel rendered="{!AND(ISBLANK(logoUrl), NOT(ISBLANK(brandName)))}">
        <div class="brand-name">{!brandName}</div>
    </apex:outputPanel>

    <!-- Success -->
    <apex:outputPanel rendered="{!status == 'success'}">
        <div class="icon">✓</div>
        <h1>You've been unsubscribed</h1>
        <p>You will no longer receive marketing emails from us.</p>
        <apex:form rendered="{!showResubscribe}">
            <p style="font-size:13px;color:#888;">Changed your mind?</p>
            <apex:commandButton value="Re-subscribe" action="{!resubscribe}" styleClass="btn btn-secondary"/>
        </apex:form>
    </apex:outputPanel>

    <!-- Already opted out -->
    <apex:outputPanel rendered="{!status == 'already'}">
        <div class="icon">ℹ</div>
        <h1>Already unsubscribed</h1>
        <p>Your email address is already marked as unsubscribed.</p>
        <apex:form rendered="{!showResubscribe}">
            <p style="font-size:13px;color:#888;">Changed your mind?</p>
            <apex:commandButton value="Re-subscribe" action="{!resubscribe}" styleClass="btn btn-secondary"/>
        </apex:form>
    </apex:outputPanel>

    <!-- Re-subscribed -->
    <apex:outputPanel rendered="{!status == 'resubscribed'}">
        <div class="icon">✓</div>
        <h1>You've been re-subscribed</h1>
        <p>You will receive emails from us again.</p>
    </apex:outputPanel>

    <!-- Invalid token -->
    <apex:outputPanel rendered="{!status == 'invalid'}">
        <div class="icon">⚠</div>
        <h1>Invalid link</h1>
        <p>This unsubscribe link is not valid or has expired. Please contact us if you need help.</p>
    </apex:outputPanel>

    <!-- Error -->
    <apex:outputPanel rendered="{!status == 'error'}">
        <div class="icon">⚠</div>
        <h1>Something went wrong</h1>
        <p>We were unable to process your request. Please try again later or contact us directly.</p>
    </apex:outputPanel>
</apex:outputPanel>
</div>
</body>
</html>
</apex:page>
