<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>Example auto-launched Flow: sends a Weave template via Marketing Cloud Next from a Contact record. Shows how to call the Send Weave MCN Email invocable action with templateId, recipientEmail, and context JSON.</description>
    <interviewLabel>MCN Send Template from Contact {!$Flow.CurrentDateTime}</interviewLabel>
    <label>MCN Send Template from Contact</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>

    <!-- ── Variables ──────────────────────────────────────────────────── -->

    <variables>
        <name>templateId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <description>Weave_Template_Config__c record ID</description>
    </variables>
    <variables>
        <name>contactId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <description>Contact record ID — used as the parent record context</description>
    </variables>
    <variables>
        <name>recipientEmail</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <description>Email address to send the template to</description>
    </variables>
    <variables>
        <name>sendIsSuccess</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>sendMessageId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>sendErrorMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>contextJson</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>

    <!-- ── Formula ───────────────────────────────────────────────────── -->

    <formulas>
        <name>BuildContextJson</name>
        <dataType>String</dataType>
        <expression>'{"recordId":"' &amp; {!contactId} &amp; '"}'</expression>
    </formulas>

    <!-- ── Flow ──────────────────────────────────────────────────────── -->

    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>SetContextJson</targetReference>
        </connector>
    </start>

    <assignments>
        <name>SetContextJson</name>
        <label>Set Context JSON</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <assignmentItems>
            <assignToReference>contextJson</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>BuildContextJson</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>SendWeaveMCNEmail</targetReference>
        </connector>
    </assignments>

    <actionCalls>
        <name>SendWeaveMCNEmail</name>
        <label>Send Weave MCN Email</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <actionName>MCNFlowActionAdapter</actionName>
        <actionType>apex</actionType>
        <inputParameters>
            <name>templateId</name>
            <value><elementReference>templateId</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>recipientEmail</name>
            <value><elementReference>recipientEmail</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>contextVariablesJson</name>
            <value><elementReference>contextJson</elementReference></value>
        </inputParameters>
        <outputParameters>
            <assignToReference>sendIsSuccess</assignToReference>
            <name>isSuccess</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>sendMessageId</assignToReference>
            <name>messageId</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>sendErrorMessage</assignToReference>
            <name>errorMessage</name>
        </outputParameters>
    </actionCalls>

</Flow>
