<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>Example Flow showing how to send a Weave template via Marketing Cloud Next from a Contact record. Demonstrates the Send Weave MCN Email invocable action.</description>
    <interviewLabel>MCN Send Template from Contact {!$Flow.CurrentDateTime}</interviewLabel>
    <label>MCN Send Template from Contact</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <connector>
            <targetReference>BuildContextJson</targetReference>
        </connector>
    </start>
    <status>Active</status>

    <!-- Input variables -->
    <variables>
        <name>templateId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <description>Weave_Template_Config__c record ID</description>
    </variables>
    <variables>
        <name>contactId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <description>Contact record ID to use as parent record</description>
    </variables>
    <variables>
        <name>recipientEmail</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <description>Email address to send to</description>
    </variables>

    <!-- Output variables -->
    <variables>
        <name>sendIsSuccess</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>sendMessageId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>sendErrorMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>contextJson</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>

    <!-- Build context JSON using Formula -->
    <formulas>
        <name>BuildContextJson</name>
        <dataType>String</dataType>
        <expression>"{""recordId"":""" &amp; {!contactId} &amp; """}"</expression>
    </formulas>

    <!-- Assign formula result to variable -->
    <assignments>
        <name>SetContextJson</name>
        <label>Set Context JSON</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <assignmentItems>
            <assignToReference>contextJson</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>BuildContextJson</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>SendWeaveMCNEmail</targetReference>
        </connector>
    </assignments>

    <!-- Invocable action call -->
    <actionCalls>
        <name>SendWeaveMCNEmail</name>
        <label>Send Weave MCN Email</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <actionName>MCNFlowActionAdapter</actionName>
        <actionType>apex</actionType>
        <inputParameters>
            <name>templateId</name>
            <value><elementReference>templateId</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>recipientEmail</name>
            <value><elementReference>recipientEmail</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>contextVariablesJson</name>
            <value><elementReference>contextJson</elementReference></value>
        </inputParameters>
        <outputParameters>
            <assignToReference>sendIsSuccess</assignToReference>
            <name>isSuccess</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>sendMessageId</assignToReference>
            <name>messageId</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>sendErrorMessage</assignToReference>
            <name>errorMessage</name>
        </outputParameters>
        <connector>
            <targetReference>CheckResult</targetReference>
        </connector>
    </actionCalls>

    <!-- Decision: success or failure -->
    <decisions>
        <name>CheckResult</name>
        <label>Check Send Result</label>
        <locationX>176</locationX>
        <locationY>408</locationY>
        <defaultConnectorLabel>Send Failed</defaultConnectorLabel>
        <rules>
            <name>SendSucceeded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>sendIsSuccess</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><booleanValue>true</booleanValue></rightValue>
            </conditions>
            <connector>
                <targetReference>LogSuccess</targetReference>
            </connector>
            <label>Send Succeeded</label>
        </rules>
    </decisions>

    <!-- Success screen (screen flow variant) -->
    <screens>
        <name>LogSuccess</name>
        <label>Send Successful</label>
        <locationX>44</locationX>
        <locationY>528</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>SuccessMsg</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Email sent successfully via Marketing Cloud Next.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Message ID: {!sendMessageId}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>

    <screens>
        <name>LogFailure</name>
        <label>Send Failed</label>
        <locationX>308</locationX>
        <locationY>528</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>FailMsg</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Email send failed.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;{!sendErrorMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
</Flow>
